                    "instructions": "Өөрийн иконыг зургаар оруулж болно. (SVG эсвэл PNG)",
                    "required": 0,
                    "return_format": "id",
                    "preview_size": "thumbnail",
                    "library": "all"
                },
                {
                    "key": "field_vp_item_icon",
                    "label": "Бэлэн икон сонгох",
                    "name": "icon",
                    "type": "select",
                    "required": 1,
                    "instructions": "Дээрх талбарт зураг хуулаагүй тохиолдолд харагдана.",
                    "choices": {
                        "map-pin": "Map Pin (Байршил)",
                        "graduation-cap": "Graduation Cap (Сургалт)",
                        "users": "Users (Community)",
                        "clipboard-check": "Clipboard Check (Зөвлөгөө)"
                    },
                    "default_value": "map-pin",
                    "conditional_logic": [
                        {
                            "field": "field_vp_item_custom_icon",
                            "operator": "==",
                            "value": ""
                        }
                    ]
                },
                {
                    "key": "field_vp_item_title",
                    "label": "Картын гарчиг",
                    "name": "title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_vp_item_description",
                    "label": "Картын тайлбар",
                    "name": "description",
                    "type": "textarea",
                    "required": 0,
                    "rows": 2
                },
                {
                    "key": "field_vp_item_link",
                    "label": "Картын холбоос (Link)",
                    "name": "link",
                    "type": "url",
                    "instructions": "Картыг дарахад шилжих хаяг (Заавал биш).",
                    "required": 0
                }
            ]
        },
        {
            "key": "field_vp_title_mw",
            "label": "Гарчиг өргөн (Title Max Width)",
            "name": "vp_title_max_width",
            "type": "range",
            "default_value": 960,
            "min": 500,
            "max": 768,
            "step": 10,
            "append": "px"
        },
        {
            "key": "field_vp_desc_mw",
            "label": "Тайлбар өргөн (Desc Max Width)",
            "name": "vp_description_max_width",
            "type": "range",
            "default_value": 720,
            "min": 500,
            "max": 768,
            "step": 10,
            "append": "px"
        }
    ],
    "location": [
        [
            {
                "param": "block",
