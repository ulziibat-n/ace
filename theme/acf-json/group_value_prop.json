            "instructions": "Гарчгийн доор харагдах дэлгэрэнгүй текст.",
            "required": 0,
            "rows": 3,
            "default_value": "Бид зөвхөн Солонгос улсад төвлөрч, таны ирээдүйн боловсрол болон карьерын замыг хамгийн мэргэжлийн түвшинд чиглүүлэх батлагдсан кейсүүдтэй хамт олон юм."
        },
        {
            "key": "field_vp_btn_label",
            "label": "Товчлуурын текст",
            "name": "vp_btn_label",
            "type": "text",
            "instructions": "Гарчгийн доор харагдах товчлуурын нэр (Жишээ нь: Бүгдийг харах).",
            "required": 0
        },
        {
            "key": "field_vp_btn_url",
            "label": "Товчлуурын линк",
            "name": "vp_btn_url",
            "type": "text",
