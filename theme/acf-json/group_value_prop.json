            "instructions": "Слайдаар харагдах давуу талуудыг нэмнэ үү.",
            "required": 0,
            "layout": "block",
            "button_label": "Карт нэмэх",
            "sub_fields": [
                {
                    "key": "field_vp_item_custom_icon",
                    "label": "Зураг хуулах (Custom Icon)",
                    "name": "custom_icon",
