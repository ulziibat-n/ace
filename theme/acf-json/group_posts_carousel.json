{
	"key": "group_posts_carousel",
	"title": "Posts Carousel Settings",
	"fields": [
		{
			"key": "field_pc_title",
			"label": "Гарчиг",
			"name": "pc_title",
			"type": "text"
		},
		{
			"key": "field_pc_description",
			"label": "Тайлбар",
			"name": "pc_description",
			"type": "textarea",
			"rows": 2
		},
		{
			"key": "field_pc_link",
			"label": "Холбоос",
			"name": "pc_link",
			"type": "link",
			"return_format": "array"
		},
		{
			"key": "field_pc_filter_type",
			"label": "Шүүлтүүрийн төрөл",
			"name": "pc_filter_type",
			"type": "select",
			"choices": {
				"all": "Бүгд",
				"category": "Ангиллаар",
				"manual": "Гараар сонгох"
			},
			"default_value": "all"
		},
		{
			"key": "field_pc_category_filter",
			"label": "Ангилал",
			"name": "pc_category_filter",
			"type": "taxonomy",
			"taxonomy": "category",
			"field_type": "multi_select",
			"add_term": 0,
			"load_terms": 0,
			"return_format": "id",
			"conditional_logic": [
				{
					"field": "field_pc_filter_type",
					"operator": "==",
					"value": "category"
				}
			]
		},
		{
			"key": "field_pc_selected_posts",
			"label": "Нийтлэл сонгох",
			"name": "pc_selected_posts",
			"type": "relationship",
			"post_type": ["post"],
			"filters": ["search", "taxonomy"],
			"return_format": "id",
			"conditional_logic": [
				{
					"field": "field_pc_filter_type",
					"operator": "==",
					"value": "manual"
				}
			]
		},
		{
			"key": "field_pc_posts_count",
			"label": "Харуулах тоо",
			"name": "pc_posts_count",
			"type": "number",
			"default_value": 10
		},
		{
			"key": "field_pc_title_mw",
			"label": "Гарчиг өргөн (Title Max Width)",
			"name": "pc_title_max_width",
			"type": "range",
			"default_value": 960,
			"min": 500,
			"max": 768,
			"step": 10,
			"append": "px"
		},
		{
			"key": "field_pc_desc_mw",
			"label": "Тайлбар өргөн (Desc Max Width)",
			"name": "pc_description_max_width",
			"type": "range",
			"default_value": 720,
			"min": 500,
			"max": 768,
			"step": 10,
			"append": "px"
		}
	],
	"location": [
		[
			{
				"param": "block",
				"operator": "==",
				"value": "acf/posts-carousel"
			}
		]
	],
	"menu_order": 0,
	"position": "normal",
	"style": "default",
	"label_placement": "top",
	"instruction_placement": "label",
	"hide_on_screen": ""
}
